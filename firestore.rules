rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'GANTI_DENGAN_EMAIL_ADMIN_ANDA';
    }
    match /services/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /articles/{id} { allow read: if resource.data.published == true || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /faqs/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /customSections/{id} { allow read: if resource.data.active == true || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /site/{id} { allow read: if id == 'settings'; allow create, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}